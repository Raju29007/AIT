from collections import deque

initial_state = ("door", "corner", False, False)

def get_next_states(state):
    monkey, box, on_box, banana = state
    states = []

    if not on_box and monkey != box:
        states.append(("corner", box, False, banana))

    if not on_box and monkey == box and box != "middle":
        states.append(("middle", "middle", False, banana))

    if not on_box and monkey == box and box == "middle":
        states.append(("middle", "middle", True, banana))

    if on_box and monkey == "middle" and box == "middle":
        states.append(("middle", "middle", True, True))

    return states


def bfs():
    queue = deque()
    queue.append((initial_state, []))
    visited = {initial_state}

    while queue:
        state, path = queue.popleft()

        if state[3] == True:
            return path + [state]

        for next_state in get_next_states(state):
            if next_state not in visited:
                visited.add(next_state)
                queue.append((next_state, path + [state]))

    return None


solution = bfs()

if solution:
    print("Monkey and Banana Problem")
    print()

    for i, state in enumerate(solution):
        monkey, box, on_box, banana = state

        if i == 0:
            print("Step 0: Initial state")
        elif i == 1:
            print("Step 1: Monkey moves to corner")
        elif i == 2:
            print("Step 2: Monkey pushes box to middle")
        elif i == 3:
            print("Step 3: Monkey climbs onto box")
        elif i == 4:
            print("Step 4: Monkey gets banana")

        print("Monkey:", monkey)
        print("Box:", box)
        print("On Box:", on_box)
        print("Has Banana:", banana)
        print()

    print("Goal achieved!")
else:
    print("No solution")
